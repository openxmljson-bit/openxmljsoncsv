# OPENXMLJSON Licensing API — environment variables.
#
# Copy to `.env` for local `netlify dev`, and set the SAME keys in the Netlify
# dashboard (Site settings ▸ Environment variables) for deployed functions.
# NEVER commit the real .env — only this .example file.

# --- Shopify Admin API (server-side secrets) --------------------------------
# Your store's .myshopify.com domain (NOT the custom storefront domain).
SHOPIFY_STORE=your-store.myshopify.com
# 2026+ custom apps: Client ID + Client Secret (exchanged for an access token
# via the client-credentials grant). Legacy apps: set SHOPIFY_ADMIN_TOKEN
# (shpat_...) instead and the code uses it directly.
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional; defaults to 2025-07 if unset.
SHOPIFY_API_VERSION=2025-07

# --- OTP email (Resend) ------------------------------------------------------
# API key from resend.com and a verified sender address/domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
OTP_FROM_EMAIL=OPENXMLJSON <login@openxmljson.com>

# --- License-key signing (server-side secret) --------------------------------
# Random 32+ byte secret. Generate with:  openssl rand -base64 48
LICENSE_SIGNING_SECRET=replace-with-a-long-random-secret
